#!/bin/sh
# Writes EVE_TRADER_COOKIE_SECRET and EVE_TRADER_TOKEN_KEY (base64 on stdin,
# one per line) to the container's env-file, then recreates the container so
# the new values take effect immediately. The app runs as a Docker container,
# not a systemd unit, so there is no service restart.
set -eu
state=/var/lib/eve-trader
name=eve-trader

mkdir -p "$state"
umask 077
IFS= read -r cookie
IFS= read -r token
printf 'EVE_TRADER_COOKIE_SECRET=%s\nEVE_TRADER_TOKEN_KEY=%s\n' \
    "$(printf '%s' "$cookie" | base64 -d)" \
    "$(printf '%s' "$token" | base64 -d)" >"$state/secrets"
chmod 600 "$state/secrets"

image=''
if docker inspect "$name" >/dev/null 2>&1; then
    image=$(docker inspect --format '{{.Config.Image}}' "$name")
    /usr/local/sbin/eve-trader-start "$image"
else
    printf '%s\n' "no $name container running; secrets stored for the next deploy" >&2
fi
