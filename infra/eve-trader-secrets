#!/bin/sh
set -eu
state=/var/lib/eve-trader
mkdir -p "$state"
umask 077
IFS= read -r cookie
IFS= read -r token
printf 'EVE_TRADER_COOKIE_SECRET=%s\nEVE_TRADER_TOKEN_KEY=%s\n' "$(printf '%s' "$cookie" | base64 -d)" "$(printf '%s' "$token" | base64 -d)" >"$state/secrets"
chmod 600 "$state/secrets"
systemctl restart eve-trader 2>/dev/null || true
