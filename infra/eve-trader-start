#!/bin/sh
# Starts (or replaces) the eve-trader container from the given image. The
# single place that wires the container's runtime: SQLite state directory,
# secrets and non-secret runtime env-files, restart policy, and the loopback
# port Caddy proxies.
set -eu
name=eve-trader
state=/var/lib/eve-trader
image=${1:?image is required}

# Recreate rather than restart: the env-files are only read at container start,
# so secret/env rotation must replace the container.
docker stop "$name" >/dev/null 2>&1 || true
docker rm "$name" >/dev/null 2>&1 || true

set -- --env-file "$state/secrets" -v "$state:/data" -p 127.0.0.1:8080:8080
if [ -f "$state/env" ]; then
    set -- "$@" --env-file "$state/env"
fi
docker run -d --name "$name" --restart unless-stopped "$@" "$image" >/dev/null
printf 'started=%s\n' "$image"
