# Copy this file to ~/eve-trader.env on the host, fill in real values, then
# `chmod 600 ~/eve-trader.env`. Never commit real values -- this filename
# lives outside the repo checkout on the host precisely so that can't happen.
#
# EVE_TRADER_ESI_CLIENT_ID / EVE_TRADER_ESI_CLIENT_SECRET come from the EVE
# SSO application at https://developers.eveonline.com/applications.
EVE_TRADER_ESI_CLIENT_ID=
EVE_TRADER_ESI_CLIENT_SECRET=
EVE_TRADER_DISCORD_WEBHOOK_URL=
